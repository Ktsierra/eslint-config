{
  "name": "@ktsierra/eslint-config",
  "version": "3.0.0-0",
  "description": "My personal ESLint configurations for TypeScript projects",
  "main": "index.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./react": {
      "import": "./react.js",
      "types": "./react.d.ts"
    },
    "./react-native": {
      "import": "./react-native.js",
      "types": "./react-native.d.ts"
    }
  },
  "keywords": [
    "eslint",
    "config",
    "typescript",
    "react"
  ],
  "author": "Jose Sierra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ktsierra/eslint-config"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:update": "node test/write-snapshot.js"
  },
  "dependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "globals": "^17.0.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.1",
    "typescript-eslint": "^8.56.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.56.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-react": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-react-refresh": {
      "optional": true
    },
    "eslint-plugin-react-native": {
      "optional": true
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "react.js",
    "react.d.ts",
    "react-native.js",
    "react-native.d.ts",
    "README.md"
  ]
}
